# DFSha · tiempos de la columna "Pruebas" de la Tabla 19 (DA-16), solo los que cambian.
# Los usan las pruebas de las tareas 25 y 26. Aquí no van secretos.
#
#   AWS:   ./infra/deploy.sh --times scripts/pruebas/pruebas.env
#          DFS_W=3 ./infra/deploy.sh --times scripts/pruebas/pruebas.env    (W=3 encima)
#   Local: cp scripts/pruebas/pruebas.env .env   (compose.local.yml lee el .env de la raíz)
#          y después docker compose -f compose.local.yml up -d
#
# Lo que no está aquí toma el valor normal de src/dfs_common/config.py. DFS_W se pasa aparte.
DFS_LEADER_GRACE_S=60
DFS_RETENTION_S=60
DFS_GC_INTERVAL_S=30
DFS_GC_MIN_AGE_S=120
