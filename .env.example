# DFSha · variables de entorno (src/dfs_common/config.py)
# Copia este archivo a .env y ajusta los valores. Aquí no van secretos: solo las
# rutas de los archivos que los contienen (DA-10, DA-15).
# Cada línea trae el valor normal; el comentario de arriba dice el valor de pruebas
# de la Tabla 19 (DA-16) cuando es distinto.

# --- Tiempos y umbrales (Tabla 19, DA-16) ---
# Tamaño de bloque en MiB (DA-03). Pruebas: 8
DFS_BLOCK_MIB=8
# Copias para confirmar un bloque (DA-04). Pruebas: 2 o 3
DFS_W=2
# Espera del primario por los secundarios, en s (DA-04). Pruebas: 10
DFS_PRIMARY_WAIT_S=10
# Lease de cada intento de lock, en s (DA-08). Pruebas: 30
DFS_LOCK_LEASE_S=30
# Intervalo de latido de los DataNodes, en s (DA-12). Pruebas: 5
DFS_HEARTBEAT_S=5
# Vencimiento de un nodo sin latidos, en s (DA-12). Pruebas: 15
DFS_NODE_LEASE_S=15
# Espera antes de re-replicar, en s (DA-12). Pruebas: 60
DFS_REREPLICATE_AFTER_S=60
# Espera del líder nuevo antes de re-replicar, en s (DA-12). Pruebas: 60
DFS_LEADER_GRACE_S=300
# Retención de la versión anterior, en s (DA-14). Pruebas: 60
DFS_RETENTION_S=600
# Cada cuánto corre la limpieza, en s (DA-02). Pruebas: 30
DFS_GC_INTERVAL_S=600
# Tiempo sin cambios para ser candidato a limpieza, en s (DA-02). Pruebas: 120
DFS_GC_MIN_AGE_S=3600

# --- Tiempos agregados en la tarea 02 (mismo valor en pruebas) ---
# Cada cuánto renueva el cliente su lock, en s (DA-08). Pruebas: 10
DFS_LOCK_RENEW_S=10
# Margen por diferencia de relojes en la limpieza, en s (DA-02). Pruebas: 1
DFS_GC_CLOCK_MARGIN_S=1

# --- Tiempo agregado en la tarea 02d (mismo valor en pruebas) ---
# Cada cuánto revisa el líder nodos caídos, copias faltantes y órdenes atascadas, en s (DA-12). Pruebas: 10
DFS_LEADER_SCAN_S=10

# --- Vencimiento de tokens (DA-10) ---
# JWT del login, en s. Pruebas: 3600
DFS_JWT_TTL_S=3600
# Pase de bloque, en s. Pruebas: 600
DFS_PASS_TTL_S=600

# --- Puertos (DA-13) ---
DFS_META_PUBLIC_PORT=8443
DFS_META_INTERNAL_PORT=8444
DFS_DN_PUBLIC_PORT=9443
DFS_DN_INTERNAL_PORT=9444

# --- Identidad y descubrimiento (DA-11) ---
# IP privadas de los 3 MetaServers, sin puerto, separadas por coma. Las escribe el script de despliegue.
# Si el laboratorio permite Route 53, puede ir un nombre DNS en su lugar (DA-11).
# El cliente usa DFS_META_PUBLIC_PORT y el DataNode DFS_META_INTERNAL_PORT.
DFS_META_SEEDS=172.31.0.10,172.31.16.10,172.31.32.10
# Nodos de etcd (solo el MetaServer), separados por coma. mTLS con el certificado DFS_TLS_* de este nodo.
DFS_ETCD_ENDPOINTS=https://172.31.0.10:2379,https://172.31.16.10:2379,https://172.31.32.10:2379
# Zona de este nodo o cliente
DFS_ZONE=us-east-1a
# Identificador de este nodo: meta1..meta3 o dn1..dn4 (el cliente no lo usa)
DFS_NODE_ID=dn1
# IP privada de este nodo, sin valor por defecto (MetaServer y DataNode; el cliente no la usa).
# La escribe el script de despliegue (DA-11).
DFS_NODE_IP=172.31.0.10
# Carpeta de bloques del DataNode (DA-02)
DFS_DATA_DIR=/data

# --- TLS (DA-06, DA-11): CA propia y certificado de este nodo ---
DFS_TLS_CA_FILE=/run/secrets/ca.crt
DFS_TLS_CERT_FILE=/run/secrets/tls.crt
DFS_TLS_KEY_FILE=/run/secrets/tls.key

# --- Archivos de secretos (DA-10): los genera el script de despliegue fuera del repositorio ---
DFS_JWT_SECRET_FILE=/run/secrets/jwt_secret
DFS_PASS_KEY_FILE=/run/secrets/pass_key
DFS_NODE_KEY_FILE=/run/secrets/node_key
# Contraseña inicial del usuario admin (solo MetaServer). Vacío = no se crea el administrador.
# En el despliegue apunta al secreto que genera el script, por ejemplo /run/secrets/admin_password.
DFS_ADMIN_PASSWORD_FILE=
